[Unit]
Description=Bluehood Bluetooth Neighborhood Monitor Daemon
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=root

# If bluehood was installed into a virtualenv, set the full path to the binary:
#   ExecStart=/opt/bluehood-venv/bin/bluehood
# If installed system-wide (pip install), use:
#   ExecStart=/usr/local/bin/bluehood
ExecStart=/usr/local/bin/bluehood

Restart=on-failure
RestartSec=5

# Data directory - adjust if you want a different location
Environment=BLUEHOOD_DATA_DIR=/var/lib/bluehood

[Install]
WantedBy=multi-user.target
